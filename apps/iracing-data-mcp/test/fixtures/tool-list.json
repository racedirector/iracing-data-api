            "type": "object",
            "properties": {
              "cust_id": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "display_name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["cust_id", "display_name"],
            "additionalProperties": false
          }
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": ["string", "null"]
        },
        "source_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
