  {
    "name": "get_series_schedule",
    "description": "Get one season schedule. race_week_num is the upstream zero-based race week (0 is the first week). Optional week filtering is local; results are deterministically ordered. Continue with cursor alone. No weather, assets, duration or recurrence interpretation.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "season_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "race_week_num": {
              "type": "integer",
              "minimum": 0,
              "maximum": 52
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": ["season_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": ["cursor"],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_race_result",
    "description": "Get bounded participants from one subsession and simsession (default 0). Positions are one-based; negative sentinels are null. Customer filters select nested team drivers with explicit team attribution, never individual standings from team totals. Empty matches do not establish participation. Preserves source order; continue with cursor alone. Requires iracing.auth.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "subsession_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cust_ids": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "simsession_number": {
              "default": 0,
              "type": "integer",
              "minimum": -20,
              "maximum": 20
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": ["subsession_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": ["cursor"],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "search_driver_races",
    "description": "Search one driver's race session summaries within an explicit start-inclusive/end-exclusive UTC range of at most 90 days, or a season year/quarter. Requires iracing.auth. Source order is subsession_id (a time proxy). track_ids filters locally, scanning at most four chunks per page; an empty incomplete page is valid. Continue with cursor alone. Summaries do not establish individual outcomes; use get_race_result for selected details and report incomplete coverage.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "cust_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "range": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "start_end": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": ["start", "start_end"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "season_year": {
                      "type": "integer",
                      "minimum": 2000,
                      "maximum": 2100
                    },
                    "season_quarter": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    }
                  },
                  "required": ["season_year", "season_quarter"],
                  "additionalProperties": false
                }
              ]
            },
            "series_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "track_ids": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "official_only": {
              "type": "boolean"
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": ["range"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": ["cursor"],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
]
