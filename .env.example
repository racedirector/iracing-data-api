IRACING_AUTH_CLIENT=
IRACING_AUTH_SECRET=
IRACING_AUTH_REDIRECT_URI=http://127.0.0.1:0/oauth/iracing/callback

# Local stdio uses the CLI's dedicated MCP credential document.
# Run `pnpm iracing-data auth login` before connecting a stdio MCP client.
# IRACING_MCP_CREDENTIAL_FILE=/absolute/path/to/credentials.json
# Optional standalone HTTP host values (HTTP must inject its own actor resolver).
# IRACING_MCP_LISTEN_HOST=127.0.0.1
# IRACING_MCP_PORT=3000
