# Repository environment options (never commit a populated .env).
# Configuration and startup troubleshooting:
# https://github.com/racedirector/iracing-data-api/tree/main/apps/iracing-data-mcp#environment-configuration
# In-repo MCP configs use dotenv CLI; the MCP executable never loads this file.
# Existing process environment values take precedence over dotenv CLI values.

# Required for local stdio and CLI login: registered iRacing OAuth client ID.
IRACING_AUTH_CLIENT=
# Required only for confidential clients; omit/leave empty for public clients.
IRACING_AUTH_SECRET=

# Selected stdio OAuth token document. Relative paths resolve from the process cwd.
# Acquire it with: pnpm iracing-data auth login --scope iracing.auth
# Read on demand by iracing-data-mcp serve.
IRACING_CREDENTIALS=.iracing-data/iracing-data-mcp/credentials.json

# serve --transport http uses 127.0.0.1:3000/mcp without caller authentication.
# Do not expose the development listener publicly.
# Explicit access-token override for MCP or CLI API requests:
# IRACING_ACCESS_TOKEN=

# CLI-only options below are NOT consumed by the MCP runtime.
# Login callback override; the default uses a dynamically assigned loopback port.
# IRACING_AUTH_REDIRECT_URI=http://127.0.0.1:0/oauth/iracing/callback
# Password-limited login only; browser login is preferred.
# IRACING_AUTH_USERNAME=
# IRACING_AUTH_PASSWORD=
