IRACING_AUTH_CLIENT=
IRACING_AUTH_SECRET=
IRACING_AUTH_REDIRECT_URI=http://127.0.0.1:0/oauth/iracing/callback

# Optional local MCP HTTP overrides. The defaults are loopback-only on port 3000.
# IRACING_MCP_ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000
# IRACING_MCP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Normal local setup does not require UID/GID or data-directory settings.
# `pnpm mcp:local login` stores MCP state in the Docker-managed named volume.
