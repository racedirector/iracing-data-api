IRACING_AUTH_CLIENT=
IRACING_AUTH_SECRET=
IRACING_AUTH_REDIRECT_URI=http://127.0.0.1:0/oauth/iracing/callback

# Local Docker MCP. Set these to `id -u` and `id -g` on the host.
IRACING_MCP_UID=
IRACING_MCP_GID=

# Optional when the registered client requires a secret. The file must live in
# .iracing-data/iracing-data-mcp on the host and be mode 0600.
# IRACING_MCP_CLIENT_SECRET_FILE=/var/lib/iracing-data-mcp/client-secret
