{
  "name": "iracing-data-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "iracing-data": "node --env-file-if-exists=.env apps/iracing-data-cli/dist/index.js",
    "mcp:local": "node --env-file-if-exists=.env apps/iracing-data-mcp/scripts/local-container.mjs",
    "codegen": "node scripts/check-generated.mjs --write",
    "codegen:client": "pnpm -w --parallel --stream '/^codegen:client:(api|oauth):.+$/'",
    "codegen:client:api": "pnpm -w --parallel --stream '/^codegen:client:api:.+$/'",
    "codegen:client:api:axios": "./scripts/openapi-generator-axios.sh",
    "codegen:client:api:fetch": "./scripts/openapi-generator-fetch.sh",
    "codegen:client:api:rust": "./scripts/openapi-generator-rust.sh",
    "codegen:client:oauth:fetch": "sh ./scripts/openapi-generator-oauth-fetch.sh",
    "codegen:openapi": "pnpm -w --parallel --stream '/^codegen:openapi:.+$/'",
    "codegen:openapi:api": "iracing-api-openapi -o ./openapi -f iracing.json",
    "codegen:openapi:api:yaml": "iracing-api-openapi -o ./openapi -f iracing.yaml",
    "codegen:openapi:oauth": "iracing-oauth-api-openapi -o ./openapi -f oauth.json",
    "codegen:openapi:oauth:yaml": "iracing-oauth-api-openapi -o ./openapi -f oauth.yaml",
    "lint:fix": "pnpm lint --fix",
    "lint": "eslint .",
    "style:fix": "prettier --write .",
    "style": "prettier --check .",
    "format": "pnpm lint:fix && pnpm style:fix",
    "build": "pnpm --recursive --stream build",
    "dev": "NODE_ENV=development pnpm --stream '/^dev:.+$/'",
    "dev:tsc": "tsc --build tsconfig.json --watch",
    "dev:pkg": "pnpm --recursive --parallel --stream dev",
    "test": "pnpm --recursive --if-present test",
    "check:topology": "node scripts/check-topology.js",
    "test:topology": "node --test scripts/check-topology.test.js",
    "check:service-client-boundary": "node scripts/check-service-client-boundary.mjs",
    "test:service-client-boundary": "node --test scripts/check-service-client-boundary.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:repo": "node scripts/verify.mjs repo",
    "verify:js": "node scripts/verify.mjs js",
    "verify:examples": "node scripts/verify.mjs examples",
    "verify:generated": "node scripts/verify.mjs generated",
    "verify:rust": "node scripts/verify.mjs rust",
    "test:verification": "node --test scripts/verify.test.mjs scripts/eslint-jsdoc-policy.test.mjs scripts/eslint-quality-policy.test.mjs scripts/eslint-zod-policy.test.mjs",
    "test:jsdoc-policy": "node --test scripts/eslint-jsdoc-policy.test.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "test:codegen": "node --test scripts/*presentation.test.mjs scripts/check-generated.test.mjs",
    "impact": "node scripts/workspace-impact.mjs",
    "test:impact": "node --test scripts/workspace-impact.test.mjs",
    "test:release": "node --test scripts/release-notes.test.mjs",
    "test:dependencies": "node --test scripts/dependency-updates.test.mjs",
    "check:agent-regressions": "node scripts/agent-regressions.mjs",
    "test:agent-regressions": "node --test scripts/agent-regressions.test.mjs",
    "test:compatibility-audits": "node --test scripts/audit-data-docs.test.cjs .agents/skills/iracing-data-api-compatibility-audit/audit-guidance.test.mjs .agents/skills/iracing-oauth-compatibility-audit/audit-guidance.test.mjs",
    "test:schema-compatibility": "node --test -r ts-node/register tests/schema-compatibility/*.test.cjs",
    "test:data-contract": "node --test tests/data-contract/*.test.cjs",
    "test:docker": "pnpm --filter '@iracing-data/iracing-data-mcp...' build && node apps/iracing-data-mcp/test/docker/recovery.mjs",
    "verify:docker": "pnpm test:docker",
    "test:lint-policy": "node --test scripts/eslint-jsdoc-policy.test.mjs scripts/eslint-quality-policy.test.mjs scripts/eslint-zod-policy.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@iracing-data/api-schema-to-openapi": "workspace:*",
    "@iracing-data/cli": "workspace:*",
    "@iracing-data/oauth-schema-to-openapi": "workspace:*",
    "@openapitools/openapi-generator-cli": "^2.31.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26",
    "dotenv": "18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "65.3.4",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-zod": "5.0.1",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "prettier-config-standard": "7.0.0",
    "smol-toml": "^1.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.11.2",
  "private": true
}
