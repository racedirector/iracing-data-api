{
  "name": "iracing-data-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "codegen": "node scripts/check-generated.mjs --write",
    "codegen:client": "pnpm -w --parallel --stream '/^codegen:client:api:.+$/'",
    "codegen:client:api": "pnpm -w --parallel --stream '/^codegen:client:api:.+$/'",
    "codegen:client:api:axios": "./scripts/openapi-generator-axios.sh",
    "codegen:client:api:fetch": "./scripts/openapi-generator-fetch.sh",
    "codegen:client:api:rust": "./scripts/openapi-generator-rust.sh",
    "codegen:openapi": "pnpm -w --parallel --stream '/^codegen:openapi:.+$/'",
    "codegen:openapi:api": "iracing-api-openapi -o ./openapi -f iracing.json",
    "codegen:openapi:api:yaml": "iracing-api-openapi -o ./openapi -f iracing.yaml",
    "codegen:openapi:oauth": "iracing-oauth-api-openapi -o ./openapi -f oauth.json",
    "codegen:openapi:oauth:yaml": "iracing-oauth-api-openapi -o ./openapi -f oauth.yaml",
    "lint:fix": "pnpm lint --fix",
    "lint": "eslint .",
    "style:fix": "prettier --write .",
    "style": "prettier --check .",
    "format": "pnpm lint:fix && pnpm style:fix",
    "build": "pnpm --recursive --stream build",
    "dev": "NODE_ENV=development pnpm --stream '/^dev:.+$/'",
    "dev:tsc": "tsc --build tsconfig.json --watch",
    "dev:pkg": "pnpm --recursive --parallel --stream dev",
    "test": "pnpm --recursive --if-present test",
    "check:topology": "node scripts/check-topology.js",
    "test:topology": "node --test scripts/check-topology.test.js",
    "verify": "node scripts/verify.mjs",
    "verify:repo": "node scripts/verify.mjs repo",
    "verify:js": "node scripts/verify.mjs js",
    "verify:examples": "node scripts/verify.mjs examples",
    "verify:generated": "node scripts/verify.mjs generated",
    "verify:rust": "node scripts/verify.mjs rust",
    "test:verification": "node --test scripts/verify.test.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "test:codegen": "node --test scripts/*presentation.test.mjs scripts/check-generated.test.mjs",
    "impact": "node scripts/workspace-impact.mjs",
    "test:impact": "node --test scripts/workspace-impact.test.mjs",
    "test:dependencies": "node --test scripts/dependency-updates.test.mjs",
    "check:agent-regressions": "node scripts/agent-regressions.mjs",
    "test:agent-regressions": "node --test scripts/agent-regressions.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@iracing-data/api-schema-to-openapi": "workspace:*",
    "@iracing-data/oauth-schema-to-openapi": "workspace:*",
    "@openapitools/openapi-generator-cli": "^2.31.1",
    "@types/lodash": "^4.17.15",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.1",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.8",
    "prettier-config-standard": "7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "yaml": "^2.9.1",
    "smol-toml": "^1.4.2"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "private": true
}
