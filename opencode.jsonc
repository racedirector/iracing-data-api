{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "iracing-data": {
      "type": "local",
      // Use the installed public executable, including for workspace development.
      // dotenv CLI owns .env loading; the MCP executable only parses its environment.
      // Copy .env.example to .env and configure the OAuth registration and credential
      // path. See apps/iracing-data-mcp/README.md#environment-configuration.
      "command": [
        "pnpm",
        "exec",
        "dotenv",
        "-e",
        ".env",
        "--",
        "iracing-data-mcp",
      ],
      "enabled": true,
      "timeout": 10000,
    },
  },
}
