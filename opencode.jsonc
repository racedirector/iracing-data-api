{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "iracing-data-http": {
        "type": "remote",
        "url": "http://localhost:3000/mcp",
        "disabled": true,
        "timeout": {
          "catalog": 10000,
          "execution": 10000,
        },
      },
      "iracing-data-stdio": {
        "type": "local",
        "disabled": true,
        "command": [
          "pnpm",
          "exec",
          "dotenv",
          "-e",
          ".env",
          "--",
          "iracing-data-mcp",
          "serve",
        ],
      },
    },
  },
}
